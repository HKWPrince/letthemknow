# Copy to .env (never commit .env). Values below are placeholders for local dev.
# Generate secrets with:  openssl rand -base64 32

# --- Compose ---
# "app" starts api+web+cloudflared in addition to mysql+redis.
# Use `docker compose --profile infra up` to start only mysql+redis (the CLI flag overrides this).
COMPOSE_PROFILES=app
GHCR_OWNER=your-github-owner
IMAGE_TAG=latest

# Host port mappings for the infra profile (local machine). 3307 avoids a local MySQL on 3306.
# The local API itself runs outside Docker on 8081 (application-local.yml).
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# --- Application secrets ---
LTK_MASTER_KEY=CHANGE_ME_run_openssl_rand_-base64_32
LTK_JWT_SECRET=CHANGE_ME_run_openssl_rand_-base64_32

# Shared code for self-service signup at /signup. Leave EMPTY to keep signup disabled:
# unset means closed, never open. Set it to let people create their own workspace.
LTK_SIGNUP_CODE=

# --- Database (MySQL 8) ---
MYSQL_ROOT_PASSWORD=LetThemKnow_Root!Pass
DB_URL=jdbc:mysql://mysql:3306/letthemknow?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=letthemknow
DB_PASSWORD=LetThemKnow_Str0ng!Pass

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Workers (same process runs API + workers in v1) ---
APP_WORKER_ENABLED=true

# --- Cloudflare Tunnel (prod only) ---
CLOUDFLARE_TUNNEL_TOKEN=
