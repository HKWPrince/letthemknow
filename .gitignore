# ---------------------------------------------------------------------------
# Secrets / local env
#
# NOTE: .gitignore only protects files git is not already tracking. It cannot
# stop a secret pasted into a tracked file (a README, a runbook, a test).
# For that, see the guard in scripts/check-secrets.sh and the "Publishing this
# repository" section of DEPLOY.md.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# Key material, in any directory
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*_rsa
*_ed25519
!*.pub
secrets/
credentials.json
service-account*.json
gha-creds-*.json

# Java / Maven
api/target/
*.class
*.jar
!api/.mvn/wrapper/*.jar
*.log
hs_err_pid*
replay_pid*

# Node
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
.pnpm-store/

# Generated copy of the root PRD.html, written by web's prebuild step. The root file is the
# single source of truth; committing both invites them to drift apart.
web/public/PRD.html

# Test / build output
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/
coverage/
openapi.json

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Claude Code local state
.claude/
